#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  cat <<'HELP'
Usage: bin/verify-native-install FULL_ZIP [DEBIAN_IMAGE]

Test the complete package in a disposable native Debian filesystem.
DEBIAN_IMAGE is debian:bookworm-slim (default) or debian:trixie-slim.
Requires Docker and outbound package access on the test machine only.

Actual native PHP packages, application initialization, permissions, and startup
guards are checked, including existing-site package/configuration preservation.
Only systemctl daemon-reload is simulated; no application
workers or web services start. Host application settings are not forwarded.
HELP
  exit 0
fi
if (( $# < 1 || $# > 2 )); then
  echo 'Usage: bin/verify-native-install FULL_ZIP [DEBIAN_IMAGE]' >&2
  exit 64
fi
archive="$(realpath -- "$1")"
[[ -f "$archive" ]] || { echo 'A complete release ZIP is required.' >&2; exit 1; }
image="${2:-debian:bookworm-slim}"
case "$image" in
  debian:bookworm-slim|debian:trixie-slim) ;;
  *) echo 'Choose debian:bookworm-slim or debian:trixie-slim.' >&2; exit 64 ;;
esac
export DOCKER_CONFIG="${DOCKER_CONFIG:-/tmp/coin-bot-docker}"
trust_args=()
trust_file="${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}"
if [[ -f "$trust_file" ]]; then
  trust_args=(--volume "$trust_file:/run/host-ca.pem:ro")
fi

docker run --rm --init --interactive --network host \
  --env HTTP_PROXY --env HTTPS_PROXY --env NO_PROXY --env http_proxy --env https_proxy --env no_proxy \
  "${trust_args[@]}" --volume "$archive:/run/coin-bot-full.zip:ro" \
  "$image" bash -s <<'SMOKE'
set -euo pipefail
export http_proxy="${http_proxy:-${HTTP_PROXY:-}}"
export https_proxy="${https_proxy:-${HTTPS_PROXY:-}}"
export no_proxy="${no_proxy:-${NO_PROXY:-}}"

cleanup() {
  local result=$?
  if [[ -f /tmp/coin-bot-original-os-release ]]; then
    cat /tmp/coin-bot-original-os-release > /etc/os-release
  fi
  if [[ $result != 0 && -f /tmp/coin-bot-installation.log ]]; then
    tail -60 /tmp/coin-bot-installation.log >&2
  elif [[ $result != 0 && -f /tmp/coin-bot-bootstrap.log ]]; then
    tail -60 /tmp/coin-bot-bootstrap.log >&2
  fi
  exit "$result"
}
trap cleanup EXIT

# Preserve TLS verification even where the test network uses a managed CA.
if [[ -f /run/host-ca.pem ]]; then
  install -d -m 0755 /etc/ssl/certs /usr/local/share/coin-bot-test
  install -m 0644 /run/host-ca.pem /usr/local/share/coin-bot-test/ca-certificates.crt
  install -m 0644 /run/host-ca.pem /etc/ssl/certs/ca-certificates.crt
  printf 'Acquire::https::CaInfo "/usr/local/share/coin-bot-test/ca-certificates.crt";\n' > /etc/apt/apt.conf.d/99coin-bot-test-ca
  chmod 0644 /etc/apt/apt.conf.d/99coin-bot-test-ca
  export SSL_CERT_FILE=/usr/local/share/coin-bot-test/ca-certificates.crt
  export CURL_CA_BUNDLE="$SSL_CERT_FILE"
  find /etc/apt/sources.list.d -type f -exec sed -i 's|http://deb.debian.org|https://deb.debian.org|g' {} +
fi
apt-get update >/tmp/coin-bot-bootstrap.log 2>&1
DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl unzip passwd util-linux >>/tmp/coin-bot-bootstrap.log 2>&1
if [[ -f /run/host-ca.pem ]]; then
  install -m 0644 /run/host-ca.pem /etc/ssl/certs/ca-certificates.crt
fi
mkdir -p /tmp/package /usr/local/bin /usr/local/sbin /etc/systemd/system
unzip -q /run/coin-bot-full.zip -d /tmp/package
cd /tmp/package/coin-bot
test -f deploy/install-debian.sh

# A container is not a booted systemd host. Only this reload is permitted.
cat > /usr/local/bin/systemctl <<'CONTROL'
#!/bin/sh
printf '%s\n' "$*" >> /tmp/coin-bot-systemctl-calls
[ "$#" -eq 1 ] && [ "$1" = daemon-reload ]
CONTROL
chmod 0755 /usr/local/bin/systemctl

# Legacy instructions must reach the same generic installer without mutation.
bash deploy/install-debian13.sh --help >/tmp/coin-bot-legacy-help
grep -Fq 'Usage: sudo bash deploy/install-debian.sh' /tmp/coin-bot-legacy-help
grep -Fq 'Debian 12 (Bookworm) or Debian 13 (Trixie)' /tmp/coin-bot-legacy-help

# Distro guards must reject unsupported/mismatched metadata before APT or users.
cat /etc/os-release >/tmp/coin-bot-original-os-release
original_os_hash="$(sha256sum /etc/os-release | cut -d ' ' -f 1)"
original_os_link="$(readlink /etc/os-release || true)"
source /etc/os-release
original_version="$VERSION_ID"
mkdir -p /tmp/coin-bot-guard-bin
cat > /tmp/coin-bot-guard-bin/apt-get <<'APT_GUARD'
#!/bin/sh
printf 'Unexpected APT invocation.\n' >/tmp/coin-bot-unexpected-apt
exit 99
APT_GUARD
chmod 0755 /tmp/coin-bot-guard-bin/apt-get
for fixture in unsupported mismatched; do
  if [[ "$fixture" == unsupported ]]; then
    printf 'ID=debian\nVERSION_ID="11"\nVERSION_CODENAME=bullseye\n' > /etc/os-release
    expected_error='Debian 12 (Bookworm) or Debian 13 (Trixie) is required.'
  else
    printf 'ID=debian\nVERSION_ID="12"\nVERSION_CODENAME=trixie\n' > /etc/os-release
    expected_error='version and codename do not match'
  fi
  if PATH="/tmp/coin-bot-guard-bin:$PATH" bash deploy/install-debian.sh > /tmp/coin-bot-distro-refusal.log 2>&1; then
    echo 'Invalid distribution metadata was unexpectedly accepted.' >&2
    exit 1
  fi
  grep -Fq "$expected_error" /tmp/coin-bot-distro-refusal.log
  test ! -e /tmp/coin-bot-unexpected-apt
  test ! -e /home/www/coinbot
  if getent passwd coin-bot >/dev/null; then exit 1; fi
  cat /tmp/coin-bot-original-os-release > /etc/os-release
  test "$original_os_hash" = "$(sha256sum /etc/os-release | cut -d ' ' -f 1)"
  test "$original_os_link" = "$(readlink /etc/os-release || true)"
done

# Existing sites must be refused before package changes when PHP 8.5 is absent.
# These are inert fixtures, not running web services.
mkdir -p /etc/nginx/sites-enabled /etc/php/8.5/fpm/pool.d /tmp/coin-bot-web-fixtures /tmp/coin-bot-package-guard
printf 'worker_processes 7; # Existing nginx configuration fixture.\n' > /etc/nginx/nginx.conf
printf '# Existing site fixture.\nserver { listen 127.0.0.1:8080; }\n' > /etc/nginx/sites-enabled/existing-site.conf
printf '[PHP]\nmemory_limit = 321M\n' > /etc/php/8.5/fpm/php.ini
printf '[existing-site]\nuser = www-data\ngroup = www-data\npm = static\npm.max_children = 3\n' > /etc/php/8.5/fpm/pool.d/existing-site.conf
chmod 0640 /etc/nginx/nginx.conf /etc/php/8.5/fpm/php.ini /etc/php/8.5/fpm/pool.d/existing-site.conf
for executable in nginx php-fpm8.5; do
  test ! -e "/usr/local/sbin/$executable"
  cat > "/usr/local/sbin/$executable" <<'WEB_COMMAND'
#!/bin/sh
printf 'Unexpected web command invocation.\n' >/tmp/coin-bot-unexpected-web-command
exit 99
WEB_COMMAND
  chmod 0755 "/usr/local/sbin/$executable"
done
cat > /tmp/coin-bot-default-php <<'DEFAULT_PHP'
#!/bin/sh
printf 'Unexpected default PHP invocation.\n' >/tmp/coin-bot-unexpected-web-command
exit 99
DEFAULT_PHP
chmod 0755 /tmp/coin-bot-default-php
/usr/bin/update-alternatives --install /usr/bin/php php /tmp/coin-bot-default-php 900 >/dev/null
/usr/bin/update-alternatives --set php /tmp/coin-bot-default-php >/dev/null

cat > /tmp/coin-bot-package-guard/apt-get <<'APT_BLOCK'
#!/bin/sh
printf 'Unexpected APT invocation.\n' >/tmp/coin-bot-unexpected-package-change
exit 99
APT_BLOCK
cat > /tmp/coin-bot-package-guard/dpkg <<'DPKG_BLOCK'
#!/bin/sh
case "${1:-}" in
  -s|--status|-l|--list|-L|--listfiles|-S|--search|--get-selections|--compare-versions|--version|--print-architecture|--print-foreign-architectures)
    exec /usr/bin/dpkg "$@" ;;
esac
printf 'Unexpected dpkg write invocation.\n' >/tmp/coin-bot-unexpected-package-change
exit 99
DPKG_BLOCK
cat > /tmp/coin-bot-package-guard/update-alternatives <<'ALTERNATIVES_BLOCK'
#!/bin/sh
case "${1:-}" in
  --query|--display|--get-selections|--list|--version|--help)
    exec /usr/bin/update-alternatives "$@" ;;
esac
printf 'Unexpected alternatives write invocation.\n' >/tmp/coin-bot-unexpected-package-change
exit 99
ALTERNATIVES_BLOCK
chmod 0755 /tmp/coin-bot-package-guard/*

server_snapshot() {
  {
    for directory in /etc/nginx /etc/php /etc/apt; do
      if [[ -d "$directory" ]]; then
        find "$directory" -printf '%p|%y|%m|%u|%g|%l\n' | LC_ALL=C sort
        while IFS= read -r -d '' file; do
          sha256sum "$file"
        done < <(find "$directory" -type f -print0 | LC_ALL=C sort -z)
      fi
    done
    /usr/bin/update-alternatives --query php
    /usr/bin/dpkg-query -W -f='${binary:Package}\t${Version}\t${db:Status-Abbrev}\n' | LC_ALL=C sort
  } | sha256sum | cut -d ' ' -f 1
}

shared_state="$(server_snapshot)"
for mode in default no-packages; do
  arguments=()
  if [[ "$mode" == no-packages ]]; then
    arguments=(--no-packages)
    expected_error='PHP 8.5 CLI and required extensions are missing; no system packages were changed.'
  else
    expected_error='Existing web stack detected; automatic PHP package installation is disabled.'
  fi
  if PATH="/tmp/coin-bot-package-guard:$PATH" bash deploy/install-debian.sh "${arguments[@]}" > /tmp/coin-bot-shared-refusal.log 2>&1; then
    echo 'A shared host without the required PHP runtime was unexpectedly accepted.' >&2
    exit 1
  fi
  grep -Fq "$expected_error" /tmp/coin-bot-shared-refusal.log
  test "$shared_state" = "$(server_snapshot)"
  test ! -e /tmp/coin-bot-unexpected-package-change
  test ! -e /tmp/coin-bot-unexpected-web-command
  test ! -e /etc/apt/sources.list.d/coin-bot-php.list
  test ! -e /home/www/coinbot
  if getent passwd coin-bot >/dev/null; then exit 1; fi
done

# Put away only fixtures created above so the original fresh-host APT path is
# still exercised. They return later for a runtime-reuse installation check.
mv /etc/nginx /tmp/coin-bot-web-fixtures/nginx
mv /etc/php/8.5/fpm /tmp/coin-bot-web-fixtures/fpm
rmdir /etc/php/8.5 /etc/php
mv /usr/local/sbin/nginx /tmp/coin-bot-web-fixtures/nginx-command
mv /usr/local/sbin/php-fpm8.5 /tmp/coin-bot-web-fixtures/fpm-command
/usr/bin/update-alternatives --remove php /tmp/coin-bot-default-php >/dev/null

# Refuse an inaccessible existing parent before changing accounts or its mode.
mkdir -p /home/www
chmod 0700 /home/www
printf 'Existing parent fixture.\n' > /home/www/preserve-fixture
if bash deploy/install-debian.sh >/tmp/coin-bot-parent-refusal.log 2>&1; then
  echo 'A private existing parent was unexpectedly accepted.' >&2
  exit 1
fi
grep -q 'directory traversal' /tmp/coin-bot-parent-refusal.log
test "$(stat -c '%a' /home/www)" = 700
test -f /home/www/preserve-fixture
test ! -e /home/www/coinbot
if getent passwd coin-bot >/dev/null; then exit 1; fi
# A fresh installer must not write privileged code beneath a replaceable parent.
# Existing installations use the separately tested updater with a held CWD.
for unsafe_parent in writable nonroot; do
  if [[ "$unsafe_parent" == writable ]]; then
    chown root:root /home/www
    chmod 0777 /home/www
  else
    chown www-data:www-data /home/www
    chmod 0755 /home/www
  fi
  unsafe_parent_state="$(stat -c '%U:%G:%a' /home/www)"
  unsafe_parent_hash="$(sha256sum /home/www/preserve-fixture | cut -d ' ' -f 1)"
  if bash deploy/install-debian.sh >/tmp/coin-bot-parent-refusal.log 2>&1; then
    echo 'An unsafe parent was unexpectedly accepted for fresh installation.' >&2
    exit 1
  fi
  grep -q 'protected root-owned parent' /tmp/coin-bot-parent-refusal.log
  test "$unsafe_parent_state" = "$(stat -c '%U:%G:%a' /home/www)"
  test "$unsafe_parent_hash" = "$(sha256sum /home/www/preserve-fixture | cut -d ' ' -f 1)"
  test ! -e /home/www/coinbot
  if getent passwd coin-bot >/dev/null; then exit 1; fi
done
chown root:root /home/www
chmod 0755 /home/www
parent_state="$(stat -c '%U:%G:%a' /home/www)"
parent_hash="$(sha256sum /home/www/preserve-fixture | cut -d ' ' -f 1)"

# Unlisted source configuration and host settings must not enter the install.
printf 'UNLISTED_SOURCE_FIXTURE=yes\n' > .env
printf 'External database sentinel.\n' > /tmp/coin-bot-foreign.sqlite
external_hash="$(sha256sum /tmp/coin-bot-foreign.sqlite | cut -d ' ' -f 1)"
DB_DATABASE=/tmp/coin-bot-foreign.sqlite APP_KEY=fixture_injected_key \
  bash deploy/install-debian.sh >/tmp/coin-bot-installation.log 2>&1

test "$original_os_hash" = "$(sha256sum /etc/os-release | cut -d ' ' -f 1)"
test "$original_os_link" = "$(readlink /etc/os-release || true)"
source /etc/os-release
test "$VERSION_ID" = "$original_version"
case "$VERSION_ID" in
  12) expected_suite=bookworm ;;
  13) expected_suite=trixie ;;
  *) echo 'Unexpected test distribution.' >&2; exit 1 ;;
esac
grep -q "https://packages.sury.org/php/ $expected_suite main" /etc/apt/sources.list.d/coin-bot-php.list
php_package_version="$(dpkg-query -W -f='${Version}' php8.5-cli)"
case "$php_package_version" in
  *"debian${original_version}"*) ;;
  *) echo 'PHP package comes from the wrong Debian distribution.' >&2; exit 1 ;;
esac
test "$external_hash" = "$(sha256sum /tmp/coin-bot-foreign.sqlite | cut -d ' ' -f 1)"
test "$parent_state" = "$(stat -c '%U:%G:%a' /home/www)"
test "$parent_hash" = "$(sha256sum /home/www/preserve-fixture | cut -d ' ' -f 1)"
test "$(stat -c '%U:%G:%a' /home/www/coinbot/.env)" = coin-bot:coin-bot:600
test "$(stat -c '%U:%G:%a' /var/lib/coin-bot)" = coin-bot:coin-bot:700
test "$(stat -c '%U:%G' /home/www/coinbot/vendor/autoload.php)" = root:root
if grep -q 'fixture_injected\|UNLISTED_SOURCE_FIXTURE' /home/www/coinbot/.env; then exit 1; fi

runuser -u coin-bot -- env -i PATH=/usr/bin:/bin HOME=/var/lib/coin-bot /usr/bin/php8.5 -r '
chdir("/home/www/coinbot");
require "vendor/autoload.php";
$app = require "bootstrap/app.php";
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
if (PHP_MAJOR_VERSION !== 8 || PHP_MINOR_VERSION !== 5
    || !str_starts_with(config("app.key"), "base64:")
    || config("database.connections.sqlite.database") !== "/var/lib/coin-bot/database.sqlite") {
    throw new RuntimeException("Native runtime or configuration mismatch.");
}
$database = new SQLite3(config("database.connections.sqlite.database"));
if ($database->querySingle("PRAGMA integrity_check") !== "ok"
    || $database->querySingle("SELECT COUNT(*) FROM migrations") < 7) {
    throw new RuntimeException("Native database initialization failed.");
}
echo "Native PHP ", PHP_VERSION, ": application boot, migrations, SQLite integrity passed.\n";
'

config_hash="$(sha256sum /home/www/coinbot/.env | cut -d ' ' -f 1)"
if bash deploy/install-debian.sh >/tmp/coin-bot-reinstall.log 2>&1; then
  echo 'Existing installation was unexpectedly overwritten.' >&2
  exit 1
fi
test "$config_hash" = "$(sha256sum /home/www/coinbot/.env | cut -d ' ' -f 1)"
for action in enroll start; do
  if /usr/local/sbin/coin-bot "$action" >/tmp/coin-bot-startup.log 2>&1; then
    echo 'Startup without a protected backup mount was unexpectedly accepted.' >&2
    exit 1
  fi
  grep -q 'Mount the protected' /tmp/coin-bot-startup.log
done
/usr/local/sbin/coin-bot list --raw >/tmp/coin-bot-commands.list
grep -q 'access:issue' /tmp/coin-bot-commands.list
test "$(cat /tmp/coin-bot-systemctl-calls)" = daemon-reload

# Everything removed here was created by this smoke test in its disposable
# container. No host application/state directory is mounted into this test.
reset_test_installation() {
  test -f /home/www/coinbot/.env
  test "$(stat -c '%U:%G:%a' /var/lib/coin-bot)" = coin-bot:coin-bot:700
  userdel coin-bot
  if getent group coin-bot >/dev/null; then groupdel coin-bot; fi
  rm -rf -- /home/www/coinbot /var/lib/coin-bot
  rm -f -- /usr/local/sbin/coin-bot /etc/systemd/system/coin-bot@.service /etc/systemd/system/coin-bot.target
}

# Real PHP 8.5 now exists. Restore custom sites and a different default PHP
# selection; both explicit and automatic runtime reuse must leave them intact.
mv /tmp/coin-bot-web-fixtures/nginx /etc/nginx
mkdir -p /etc/php/8.5
test ! -e /etc/php/8.5/fpm
mv /tmp/coin-bot-web-fixtures/fpm /etc/php/8.5/fpm
mv /tmp/coin-bot-web-fixtures/nginx-command /usr/local/sbin/nginx
mv /tmp/coin-bot-web-fixtures/fpm-command /usr/local/sbin/php-fpm8.5
/usr/bin/update-alternatives --install /usr/bin/php php /tmp/coin-bot-default-php 900 >/dev/null
/usr/bin/update-alternatives --set php /tmp/coin-bot-default-php >/dev/null
shared_state="$(server_snapshot)"
for mode in no-packages default; do
  reset_test_installation
  arguments=()
  if [[ "$mode" == no-packages ]]; then arguments=(--no-packages); fi
  PATH="/tmp/coin-bot-package-guard:$PATH" DB_DATABASE=/tmp/coin-bot-foreign.sqlite APP_KEY=fixture_injected_key \
    bash deploy/install-debian.sh "${arguments[@]}" >/tmp/coin-bot-installation.log 2>&1
  test "$shared_state" = "$(server_snapshot)"
  test "$external_hash" = "$(sha256sum /tmp/coin-bot-foreign.sqlite | cut -d ' ' -f 1)"
  test ! -e /tmp/coin-bot-unexpected-package-change
  test ! -e /tmp/coin-bot-unexpected-web-command
  test "$(stat -c '%U:%G:%a' /home/www/coinbot/.env)" = coin-bot:coin-bot:600
  /usr/local/sbin/coin-bot list --raw >/tmp/coin-bot-commands.list
  grep -q 'access:issue' /tmp/coin-bot-commands.list
done
test "$(wc -l < /tmp/coin-bot-systemctl-calls)" = 3
test "$(grep -Fxc daemon-reload /tmp/coin-bot-systemctl-calls)" = 3
printf 'Debian %s (%s) native and shared-host installation checks passed; only Coin Bot systemd reloads simulated; web configs, packages, repositories and default PHP preserved.\n' "$VERSION_ID" "$expected_suite"
SMOKE
