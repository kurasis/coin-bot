def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def export_git(repository, revision, destination):
    archive = subprocess.check_output(["git", "archive", revision], cwd=repository)
    with tarfile.open(fileobj=io.BytesIO(archive)) as source:
        for member in source.getmembers():
            path = Path(member.name)
            require(not path.is_absolute() and ".." not in path.parts, "Unsafe baseline path.")
            require(member.isfile() or member.isdir(), "Unexpected baseline link.")
        source.extractall(destination, filter="data")
    if revision == BASELINE:
        files = {path.relative_to(destination).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
                 for path in destination.rglob("*") if path.is_file()}
        (destination / "release-manifest.json").write_text(json.dumps({
            "format": 1, "git_commit": BASELINE, "source_date_epoch": 0, "files": files,
        }, indent=2) + "\n")


def validate_component_coverage(repository, candidate):
    """A passing updater must not silently omit a changed production dependency."""
    metadata = json.loads((candidate / "deploy/native-monitoring-components.json").read_text())
    components = set(metadata["components"])
    baseline = {}
    archive = subprocess.check_output(["git", "archive", BACKUP_VERSION], cwd=repository)
    with tarfile.open(fileobj=io.BytesIO(archive)) as source:
        for member in source.getmembers():
            if member.isfile():
                baseline[member.name] = hashlib.sha256(source.extractfile(member).read()).hexdigest()
    missing = []
    for path in candidate.rglob("*"):
        if not path.is_file():
            continue
        relative = path.relative_to(candidate).as_posix()
        runtime = ((relative.startswith(("app/", "config/")) and relative.endswith(".php"))
                   or (relative.startswith("database/migrations/") and relative.endswith(".php"))
                   or relative in {"deploy/systemd/worker", "deploy/systemd/coin-bot.target", "deploy/native-monitoring-config.php", "deploy/native-preflight.php", "deploy/coin-bot", "deploy/native-backup-config.php"})
        if runtime and hashlib.sha256(path.read_bytes()).hexdigest() != baseline.get(relative):
            if relative not in components:
                missing.append(relative)
    require(not missing, "Monitoring updater omits changed runtime components: " + ", ".join(sorted(missing)))


def export_working_tree(repository, destination):
    names = subprocess.check_output(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=repository
    ).decode().split("\0")
    for name in sorted(set(names)):
        if not name or name == "release-manifest.json":
            continue
        path = Path(name)
        require(not path.is_absolute() and ".." not in path.parts, "Unsafe candidate path.")
        require(not (path.name.startswith(".env") and path.name != ".env.example"), "Local configuration is prohibited.")
        require(path.suffix.lower() not in {".sqlite", ".db", ".key", ".pem", ".cbk"}, "Local runtime state is prohibited.")
        source = repository / path
        if not source.exists():
            continue
        require(source.is_file() and not source.is_symlink() and source.resolve().is_relative_to(repository), "Unsafe candidate file.")
        target = destination / path
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)


def export_candidate_zip(archive_path, destination):
    with ZipFile(archive_path) as archive:
        members = archive.infolist()
        require(len(members) <= 20000 and sum(m.file_size for m in members) <= 256 * 1024 * 1024, "Candidate ZIP exceeds its bounded size.")
        names = set()
        selected = []
        for member in members:
            name = member.filename
            parts = name.rstrip("/").split("/")
            require(name not in names, "Candidate ZIP contains duplicate members.")
            names.add(name)
            require(not name.startswith("/") and "\\" not in name and parts[0] == "coin-bot"
                    and all(part not in {"", ".", ".."} for part in parts), "Candidate ZIP contains an unsafe path.")
            mode = member.external_attr >> 16
            require(not stat.S_ISLNK(mode) and stat.S_IFMT(mode) in {0, stat.S_IFREG, stat.S_IFDIR}, "Candidate ZIP contains a link or special file.")
            if len(parts) == 1:
                require(member.is_dir(), "Candidate ZIP root must be a directory.")
                continue
            relative = "/".join(parts[1:])
            if not member.is_dir() and (relative.startswith(("app/", "config/", "database/", "deploy/", "routes/", "bootstrap/"))
                                        or relative in {"release-manifest.json", "artisan", "composer.json", "composer.lock", ".env.example"}):
                require(member.file_size <= 16 * 1024 * 1024, "Candidate source member is oversized.")
                selected.append((relative, member))
        for relative, member in selected:
            target = destination / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            with archive.open(member) as stream:
                data = stream.read(16 * 1024 * 1024 + 1)
            require(len(data) <= 16 * 1024 * 1024, "Candidate source read budget exceeded.")
            target.write_bytes(data)
            target.chmod(0o755 if member.external_attr >> 16 & 0o111 else 0o644)
        require((destination / "release-manifest.json").is_file(), "The actual ZIP manifest is missing.")


def main():
    if sys.argv[1:] in [["--help"], ["-h"]]:
        print("Usage: bin/verify-native-monitoring [FULL_ZIP]\nTests a mixed 88483c3 + b908565 native installation with synthetic private data.\nRequires Docker, both baseline Git commits, the local coin-bot-php:8.5 image and installed development dependencies.\nNo host configuration/database is mounted; systemctl and recipients are not started.")
        return
    require(len(sys.argv) <= 2 and (len(sys.argv) == 1 or not sys.argv[1].startswith("-")), "Usage: bin/verify-native-monitoring [FULL_ZIP]")
    archive_path = Path(sys.argv[1]).expanduser().resolve() if len(sys.argv) == 2 else None
    require(archive_path is None or archive_path.is_file(), "Candidate ZIP is missing.")
    repository = Path(__file__).resolve().parent.parent
    require(shutil.which("docker") and shutil.which("git"), "Docker and Git are required.")
    require((repository / "vendor/autoload.php").is_file(), "Run the development setup first.")
    for revision in (BASELINE, BACKUP_VERSION):
        result = subprocess.run(["git", "cat-file", "-e", revision + "^{commit}"], cwd=repository, capture_output=True, check=False)
        require(result.returncode == 0, "Baseline history is missing; fetch 88483c3 and b908565 before this developer probe.")
    environment = dict(os.environ, DOCKER_CONFIG=os.environ.get("DOCKER_CONFIG", "/tmp/coin-bot-docker"))
    subprocess.run(["docker", "image", "inspect", "coin-bot-php:8.5"], env=environment, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    with tempfile.TemporaryDirectory(prefix="coin-bot-native-monitoring-") as temporary:
        root = Path(temporary)
        baseline, backup, candidate = root / "baseline", root / "backup", root / "candidate"
        baseline.mkdir(); backup.mkdir(); candidate.mkdir()
        export_git(repository, BASELINE, baseline)
        for name in BACKUP_COMPONENTS:
            target = backup / name
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(subprocess.check_output(["git", "show", BACKUP_VERSION + ":" + name], cwd=repository))
            target.chmod(0o755 if name in {"deploy/coin-bot", "deploy/systemd/worker"} else 0o644)
        if archive_path is None:
            export_working_tree(repository, candidate)
        else:
            export_candidate_zip(archive_path, candidate)
        require((candidate / "deploy/update-native-monitoring.sh").is_file()
                and (candidate / "deploy/native-monitoring-components.json").is_file(), "Monitoring updater components are not ready.")
        validate_component_coverage(repository, candidate)
        subprocess.run([
            "docker", "run", "--rm", "--init", "--interactive", "--pull=never", "--network", "none",
            "--volume", f"{root}:/fixtures:ro", "--volume", f"{repository / 'vendor'}:/runtime/vendor:ro",
            "coin-bot-php:8.5", "bash", "-s",
        ], env=environment, input=CONTAINER, text=True, check=True)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.CalledProcessError, BadZipFile, OSError) as error:
        print(f"Native monitoring probe failed: {error}", file=sys.stderr)
        raise SystemExit(1)
