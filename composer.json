{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kurasis/coin-bot",
    "type": "project",
    "description": "Multi-user key-activated USDT transaction notifications for Telegram.",
    "keywords": [
        "telegram",
        "usdt",
        "ethereum",
        "tron"
    ],
    "license": "MIT",
    "require": {
        "php": "~8.5.0",
        "ext-bcmath": "*",
        "ext-pdo_sqlite": "*",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "check": [
            "@composer validate --strict",
            "@php vendor/bin/pint --test",
            "@composer test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
