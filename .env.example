APP_NAME="Coin Bot"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Live accounts: configure two independent providers per chain.
# Ethereum: Alchemy primary + the one QuickNode Ethereum endpoint as secondary.
# TRON: TronGrid primary + a separate Chainstack TRON Mainnet node as secondary.
# Chainstack: copy the dashboard's JSON-RPC API link into the RPC_URL setting.
# For NATIVE_URL, copy HTTP API and remove a final /wallet or /wallet/ suffix.
# Keep TRON_SECONDARY_API_KEY blank when authentication is already in the URL.
ETHEREUM_PRIMARY_RPC_URL=
ETHEREUM_SECONDARY_RPC_URL=
ETHEREUM_EARLY_ENABLED=true
ETHEREUM_EARLY_INTERVAL_SECONDS=15
ETHEREUM_EARLY_CONFIRMATIONS=6
ETHEREUM_EARLY_REORG_WINDOW=128
TRON_PRIMARY_RPC_URL=
TRON_PRIMARY_NATIVE_URL=
TRON_PRIMARY_API_KEY=
TRON_SECONDARY_RPC_URL=
TRON_SECONDARY_NATIVE_URL=
TRON_SECONDARY_API_KEY=

# Bot token and access policy. Never commit actual credentials.
TELEGRAM_BOT_TOKEN=
# Optional comma-separated numeric user IDs; blank keeps individual-key invitations.
# A nonempty list also gates activation, replies, and queued notifications.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CONNECT_TIMEOUT=15
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_REQUEST_TIMEOUT=15
TELEGRAM_MAX_RESPONSE_BYTES=2097152
ACCESS_KEY_LIFETIME_HOURS=24

# Native default is offhost. Select encrypted local backups with sudo coin-bot backup:local.
OPERATIONS_BACKUP_MODE=offhost
# Native deployment sets this to the directory matching its selected backup mode.
OPERATIONS_BACKUP_DIRECTORY=/app/storage/app/backups
OPERATIONS_REQUIRE_BACKUP=true

# Sustained failed chain checks notify this internal (not Telegram) user ID.
OPERATIONS_ALERT_USER_ID=1
OPERATIONS_ALERT_FAILURE_THRESHOLD=3
OPERATIONS_ALERT_MIN_OUTAGE_SECONDS=30
OPERATIONS_ALERT_CHECK_INTERVAL_SECONDS=15

# Optional future staging recipient; this does not grant access or send messages.
TELEGRAM_STAGING_CHAT_ID=
TELEGRAM_LEASE_SECONDS=90
TELEGRAM_MAX_ATTEMPTS=12
TELEGRAM_GLOBAL_MESSAGES_PER_SECOND=25
ACCESS_ACTIVATION_ATTEMPTS=10
ACCESS_ACTIVATION_DECAY_SECONDS=300

# Declare only retention actually verified on the selected provider account.
# Blank means unknown; independent reconciliation waits rather than certifying gaps.
ETHEREUM_PRIMARY_HISTORY_START_BLOCK=
ETHEREUM_SECONDARY_HISTORY_START_BLOCK=
TRON_PRIMARY_HISTORY_START_BLOCK=
TRON_SECONDARY_HISTORY_START_BLOCK=

RPC_CIRCUIT_BASE_SECONDS=15
RPC_CIRCUIT_MAX_SECONDS=300
RECONCILIATION_RECHECK_SECONDS=43200
RECONCILIATION_ETHEREUM_OVERLAP_BLOCKS=7200
RECONCILIATION_TRON_OVERLAP_BLOCKS=28800

OPERATIONS_BACKUP_RETENTION=1440
OPERATIONS_MAX_BACKUP_AGE=180
OPERATIONS_MAX_CURSOR_AGE=1200
OPERATIONS_MAX_UNRECONCILED_AGE=1800
OPERATIONS_MAX_OUTBOX_AGE=300
OPERATIONS_MAX_HEARTBEAT_AGE=120
OPERATIONS_REQUIRED_WORKERS=
OPERATIONS_MINIMUM_FREE_BYTES=268435456
OPERATIONS_MAX_WAL_BYTES=134217728

# Optional deployment values; production launch is deferred.
COIN_BOT_UID=1000
COIN_BOT_GID=1000
COIN_BOT_BACKUP_PATH=

# Shared API pacing and local usage estimates (UTC days; dashboard billing remains authoritative).
API_USAGE_ENABLED=true
TRON_SCAN_MIN_INTERVAL_SECONDS=15
# Optional per-provider suffixes: _USAGE_PROFILE=auto|alchemy|quicknode|infura|requests,
# _RATE_GROUP=<account-name>, _RATE_PER_SECOND=<throughput units>, _DAILY_TARGET=<billing units>.
# Auto Alchemy: shared 200 CU/s; auto Infura: shared 200 credits/s. Others have no rate cap by default.
